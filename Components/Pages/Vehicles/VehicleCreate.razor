@page "/vehicles/create"
@rendermode InteractiveServer

@using AutoTrackerWeb.Models.Vehicles
@using AutoTrackerWeb.Services.Interfaces

@inject IVehicleService VehicleService
@inject NavigationManager Navigation

<PageTitle>Agregar vehiculo . AutoTracker</PageTitle>

<div class="at-page">
    <div class="at-page-header">
        <div>
            <h1>Agregar vehiculos</h1>
            <p class="at-subtitle">Registrar un vehiculo nuevo en la flota</p>
        </div>
    </div>

    <div class="at-card at-form-card">
        <EditForm Model="vehicle" OnValidSubmit="CreateVehicle">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-control">Placa</label>
                <InputText class="form-control"
                            @bind-Value="vehicle.Plate"
                            placeholder="Ej. ABC123"/>
                <ValidationMessage For="() => vehicle.Plate" />
            </div>

            <div class="mb-3">
                <label class="form-control">Marca</label>
                <InputText class="form-control"
                            @bind-Value="vehicle.Brand"
                            placeholder="Ej. Toyota"/>
                <ValidationMessage For="() => vehicle.Brand" />
            </div>

            <div class="mb-3">
                <label class="form-control">Modelo</label>
                <InputText class="form-control"
                            @bind-Value="vehicle.Model"
                            placeholder="Ej. Corolla"/>
                <ValidationMessage For="() => vehicle.Model" />
            </div>

            <div class="mb-3">
                <label class="form-control">Año</label>
                <InputText class="form-control"
                            @bind-Value="vehicle.Year"
                            placeholder="Ej. 2019"/>
                <ValidationMessage For="() => vehicle.Year" />
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="at-form-actions">
                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                    @(isSubmitting ? "Registrando..." : "Registrar vehiculo")
                </button>

                <button type="button" class="btn btn-secondary" @onclick="Cancel" disabled="@isSubmitting">
                    Cancelar
                </button>
            </div>

        </EditForm>
    </div>
</div>

@code {
    private CreateVehicleDto vehicle = new();

    private bool isSubmitting;

    private string? errorMessage;

    private async Task CreateVehicle()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await VehicleService.CreateAsync(vehicle);

            if (result is null)
            {
                errorMessage = "No fue posible registrar el vehiculo";
                return;
            }

            Navigation.NavigateTo("/vehicles");
        }
        catch(HttpRequestException)
        {
            errorMessage = "No fue posible conectar con el servidor";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/vehicles");
    }
}
