@page "/vehicles"
@rendermode InteractiveServer

@using AutoTrackerWeb.Models.Vehicles
@using AutoTrackerWeb.Services.Interfaces

@inject NavigationManager Navigation
@inject IVehicleService VehicleService

<PageTitle>Vehiculos . AutoTracker</PageTitle>

<div class="at-page">
    <div class="at-page-header">
        <div>
            <h1>Vehiculos</h1>
            <p class="at-subtitle">@vehicles.Count vehiculos(s) registrado(s)</p>
        </div>
    </div>

    <div class="at-search">
        <input class="form-control"
                @bind="searchPlate"
                @bind:event="oninput"
                @onkeyup="HandleSearchKeyUp"
                placeholder="Filtrar por placa, ej. ABC123"/>

        <button class="btn btn-primary" @onclick="Search">
            Buscar
        </button>

        <button class="btn btn-success" @onclick="Agregar">
            Agregar
        </button>

        @if (!string.IsNullOrWhiteSpace(searchPlate))
        {
            <button class="btn btn-secondary" @onclick="CleanSearch">
                Limpiar
            </button>
        }
    </div>

    <div class="at-card">
        @if (isLoading)
        {
            <p class="at-loading">Cargando vehiculos...</p>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        else if (vehicles.Count == 0)
        {
            <div class="at-empty">
                <p>No se encontraron vehiculos.</p>
            </div>
        }
        else
        {
            <div class="at-table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Placa</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Año</th>
                            <th>Motor</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var vehicle in vehicles)
                        {
                            <tr>
                                <td class="at-plate">@vehicle.Plate</td>
                                <td>@vehicle.Brand</td>
                                <td>@vehicle.Model</td>
                                <td>@vehicle.Year</td>
                                <td>
                                    <span class="at-status @(vehicle.EngineOn ? "at-status--on" : "at-status-off")">
                                        <span class="at-status-dot"></span>
                                        @(vehicle.EngineOn ? "Encendido" : "Apagado")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>


@code {
    private List<VehicleDto> vehicles = [];

    private string searchPlate = string.Empty;

    private string? errorMessage;

    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        await LoadVehicles();
    }

    private async Task HandleSearchKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(searchPlate))
        {
            await LoadVehicles();
            return;
        }

        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var vehicle = await VehicleService.GetByPlateAsync(searchPlate.Trim());

            vehicles = vehicle is null ? [] : [vehicle];
        }
        catch(HttpRequestException)
        {
            vehicles = [];
            errorMessage = "No fue posible consultar en vehiculo";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CleanSearch()
    {
        searchPlate = string.Empty;
        await LoadVehicles();
    }

    private async Task LoadVehicles()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            vehicles = await VehicleService.GetAllAsync();
        }
        catch(HttpRequestException)
        {
            vehicles = [];
            errorMessage = "No fue posible cargar los vehiculos";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Agregar()
    {
        Navigation.NavigateTo("/vehicles/create");
    }
}
